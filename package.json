{
  "name": "hopetheorylabs-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "perf:first-load": "node scripts/measure-first-load.mjs",
    "perf:lighthouse": "npm run build && node scripts/run-lighthouse-mobile.mjs",
    "test": "node --test scripts/test-api.mjs",
    "test:e2e": "node --test --test-concurrency=1 scripts/e2e.mjs",
    "serve": "node scripts/serve-out.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "axe-core": "4.10.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
